{
  "name": "atlassian-data-center-mcp",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekthar/atlassian-data-center-mcp.git"
  },
  "homepage": "https://github.com/tekthar/atlassian-data-center-mcp#readme",
  "bugs": {
    "url": "https://github.com/tekthar/atlassian-data-center-mcp/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run test --workspaces",
    "dev:jira": "npm run dev --workspace=packages/jira",
    "dev:confluence": "npm run dev --workspace=packages/confluence",
    "dev:bitbucket": "npm run dev --workspace=packages/bitbucket",
    "debug": "node mcp-live-debug.js",
    "debug:verbose": "node mcp-live-debug.js --verbose",
    "debug:ts": "nodemon --exec tsx"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.13.0",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=11.10.0 <12"
  },
  "packageManager": "npm@11.21.1",
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
