{
  "name": "mcp-bitbucket-dc",
  "version": "0.44.1",
  "description": "MCP server for Bitbucket Data Center and Bitbucket Server: browse projects, repositories, files, branches and commits, search code, and review, comment on and (opt-in) merge pull requests. Not affiliated with Atlassian.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bitbucket",
    "bitbucket-data-center",
    "bitbucket-server",
    "data-center",
    "atlassian",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-bitbucket-dc": "bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekthar/jira-dc-mcp.git",
    "directory": "packages/bitbucket"
  },
  "homepage": "https://github.com/tekthar/jira-dc-mcp#readme",
  "bugs": {
    "url": "https://github.com/tekthar/jira-dc-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "inspect": "mcp-inspector node build/index.js",
    "inspect:dev": "mcp-inspector tsx src/index.ts",
    "test": "jest",
    "bundle": "node ../../scripts/bundle-server.mjs",
    "prepack": "tsc --build && npm run bundle"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@inquirer/prompts": "7.10.1"
  },
  "devDependencies": {
    "@atlassian-dc-mcp/common": "0.43.2"
  },
  "mcpName": "io.github.tekthar/mcp-bitbucket-dc",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
