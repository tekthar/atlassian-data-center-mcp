{
  "name": "mcp-jira-dc",
  "version": "0.45.0",
  "description": "MCP server for Jira Data Center and Jira Server: search, create, update and transition issues, with comments, links, versions, agile boards and sprints, worklogs and service desk. Not affiliated with Atlassian.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "jira",
    "jira-data-center",
    "jira-server",
    "data-center",
    "atlassian",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-jira-dc": "bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekthar/jira-dc-mcp.git",
    "directory": "packages/jira"
  },
  "homepage": "https://github.com/tekthar/jira-dc-mcp#readme",
  "bugs": {
    "url": "https://github.com/tekthar/jira-dc-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "inspect": "mcp-inspector node build/index.js",
    "inspect:dev": "mcp-inspector tsx src/index.ts",
    "start": "node build/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "test": "jest",
    "bundle": "node ../../scripts/bundle-server.mjs",
    "prepack": "tsc --build && npm run bundle"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@inquirer/prompts": "7.10.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@atlassian-dc-mcp/common": "0.43.2"
  },
  "mcpName": "io.github.tekthar/mcp-jira-dc",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
