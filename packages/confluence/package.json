{
  "name": "mcp-confluence-dc",
  "version": "0.47.1",
  "description": "MCP server for Confluence Data Center and Confluence Server: search, read, create and update pages, with page trees, history, labels, comments and attachments. Not affiliated with Atlassian.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "confluence",
    "confluence-data-center",
    "confluence-server",
    "data-center",
    "atlassian",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-confluence-dc": "bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekthar/atlassian-data-center-mcp.git",
    "directory": "packages/confluence"
  },
  "homepage": "https://github.com/tekthar/atlassian-data-center-mcp#readme",
  "bugs": {
    "url": "https://github.com/tekthar/atlassian-data-center-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "inspect": "mcp-inspector node build/index.js",
    "inspect:dev": "mcp-inspector tsx src/index.ts",
    "test": "jest --passWithNoTests",
    "bundle": "node ../../scripts/bundle-server.mjs",
    "prepack": "tsc --build && npm run bundle"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@inquirer/prompts": "7.10.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "@napi-rs/keyring": "2.1.2"
  },
  "devDependencies": {
    "@atlassian-dc-mcp/common": "0.43.2"
  },
  "mcpName": "io.github.tekthar/mcp-confluence-dc",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
